* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.slnx    text
*.md      text
*.kt      text
*.gradle  text
*.sh      text eol=lf

*.png     binary
*.ico     binary
*.jpg     binary

# Signed driver package: the catalog signs the exact bytes of the INF.
third_party/** -text
*.inf     binary
*.cat     binary
*.dll     binary

# cmd.exe misreads batch files with bare LF line ends.
*.cmd     text eol=crlf
