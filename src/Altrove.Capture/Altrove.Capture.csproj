<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows.Graphics.Capture comes from the Windows SDK projection of this TFM. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Altrove.Core\Altrove.Core.csproj" />
  </ItemGroup>

  <!-- The signed virtual display driver ships next to the apps, installed on first use of "Estendi". -->
  <ItemGroup>
    <None Include="..\..\third_party\VirtualDisplayDriver\*" Link="VirtualDisplayDriver\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
