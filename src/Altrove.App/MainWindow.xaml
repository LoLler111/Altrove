<Window x:Class="Altrove.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Altrove.App"
        Title="Altrove" Width="900" Height="700" MinWidth="720" MinHeight="560"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/Altrove.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A row of pills bound to Choice<T> items. -->
        <DataTemplate x:Key="ChipTemplate">
            <RadioButton Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         IsEnabled="{Binding IsAvailable}"
                         GroupName="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="2,0,0,16">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Style="{StaticResource AccentButton}" Content="{Binding UpdateLabel}" Command="{Binding RestartToUpdateCommand}"
                        Visibility="{Binding IsUpdateReady, Converter={StaticResource Visible}}"
                        ToolTip="Chiude Altrove, installa la nuova versione e la riapre. Altrimenti si installa da sola alla chiusura." />
                <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                           HorizontalAlignment="Right" Margin="0,4,2,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/Altrove-64.png" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Altrove" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Il tuo schermo, altrove." Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Receivers -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="RICEVITORI" />
                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Indirizzo del ricevitore, es. 192.168.1.20 oppure 192.168.1.20:47800">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddAddressCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"
                               Text="Aggiungi indirizzo (es. 192.168.1.20)">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Margin="6,0,0,0" Content="Aggiungi" Command="{Binding AddAddressCommand}" />
                </Grid>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"
                        Content="Rimuovi questo indirizzo" Command="{Binding RemoveSelectedCommand}"
                        Visibility="{Binding CanRemoveSelected, Converter={StaticResource Visible}}" />
                <Grid>
                    <ListBox Style="{StaticResource ReceiverList}" ItemsSource="{Binding Receivers}"
                             SelectedItem="{Binding SelectedReceiver}" IsHitTestVisible="{Binding IsIdle}" Focusable="{Binding IsIdle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReceiverItem}">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextDimBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Top" Margin="2,4,2,0"
                               Text="Sto cercando i ricevitori in rete… Apri Altrove sul tablet, sul telefono o sulla Fire TV: compare qui da solo. Se non arriva, scrivi qui sotto l'indirizzo che il ricevitore mostra.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReceivers}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- What and how -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanChangeChoices}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="MODALITÀ" />
                        <ItemsControl ItemsSource="{Binding ModeChoices}" Tag="mode"
                                      ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanel}" />
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExtend}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SCHERMO DA DUPLICARE" Margin="0,8,0,8" />
                            <ItemsControl ItemsSource="{Binding MonitorChoices}" Tag="monitor"
                                          ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanel}" />
                        </StackPanel>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding IsExtend, Converter={StaticResource Visible}}"
                                   Text="Il ricevitore diventa un nuovo monitor, a destra degli altri e della stessa misura del suo schermo: trascinaci le finestre. Sparisce quando fermi la trasmissione." />
                        <CheckBox IsChecked="{Binding AllowTouch}" Margin="0,12,0,0"
                                  ToolTip="Dal pannello del ricevitore si sceglie tra tocco (si clicca dove si tocca) e trackpad (il dito muove il puntatore).">
                            <TextBlock Text="Usa il PC dal ricevitore (tocco e trackpad)" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding SendAudio}" Margin="0,8,0,0"
                                  ToolTip="Quello che il PC sta suonando arriva anche al ricevitore. Si accende e si spegne anche dal pannello del ricevitore.">
                            <TextBlock Text="Manda l'audio del PC al ricevitore" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding UseTabletMic}" Margin="0,8,0,0"
                                  ToolTip="La voce del microfono del tablet diventa «Microfono Altrove» in Windows: sceglilo come microfono in Teams, Discord, Zoom. La prima volta installa usbip-win2.">
                            <TextBlock Text="Usa il microfono del ricevitore («Microfono Altrove»)" />
                        </CheckBox>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Dal ricevitore si possono anche cambiare modalità e qualità durante la trasmissione." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="RISOLUZIONE" />
                        <ItemsControl ItemsSource="{Binding ResolutionChoices}" Tag="resolution"
                                      ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanel}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="FLUIDITÀ" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding FpsChoices}" Tag="fps"
                                      ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanel}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="QUALITÀ (BITRATE)" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding BitrateChoices}" Tag="bitrate"
                                      ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanel}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="Automatica adatta il flusso allo schermo del ricevitore. Se l'immagine scatta su Wi-Fi, prova 30 fps o un bitrate più basso." />
                        <CheckBox IsChecked="{Binding SoftwareEncoder}"
                                  ToolTip="Più lento: serve solo se la scheda video non ha un encoder H.264 o dà problemi.">
                            <TextBlock Text="Usa l'encoder software" />
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action bar -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="2,0,16,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Stats}" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Margin="0,0,10,0" Padding="14,6" Content="Proietta su TV" Command="{Binding CastToTvCommand}"
                    ToolTip="Apre «Trasmetti» di Windows (Win+K): sulla TV o sulla Fire TV attiva prima la duplicazione dello schermo (Miracast). Poi Win+P sceglie se duplicare o estendere." />
            <Button Grid.Column="2" MinWidth="150" Content="{Binding StartStopLabel}" Command="{Binding StartStopCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Streaming">
                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
