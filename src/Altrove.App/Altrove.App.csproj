<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Altrove</AssemblyName>
    <RootNamespace>Altrove.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>Altrove.App.Program</StartupObject>
    <!-- The same drawing as the Android launcher icon: tools/icon/make-icon.ps1 makes it. -->
    <ApplicationIcon>Assets\Altrove.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Altrove.ico" />
    <Resource Include="Assets\Altrove-64.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Altrove.Core\Altrove.Core.csproj" />
    <ProjectReference Include="..\Altrove.Capture\Altrove.Capture.csproj" />
  </ItemGroup>

</Project>
