<Window x:Class="Altrove.App.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altrove – PIN" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/Altrove.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,14" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                   Text="La prima volta il ricevitore mostra un codice di 6 cifre: scrivilo qui. Poi questo PC si collega da solo." />
        <TextBox x:Name="PinBox" FontSize="24" MaxLength="6" HorizontalContentAlignment="Center"
                 FontFamily="Consolas" TextChanged="OnPinChanged" />
        <TextBlock x:Name="Wrong" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Visibility="Collapsed" Text="Codice sbagliato: riprova con quello che vedi adesso sul ricevitore." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annulla" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="ConnectButton" Style="{StaticResource AccentButton}" Content="Collega" IsDefault="True"
                    IsEnabled="False" Click="OnConnect" />
        </StackPanel>
    </StackPanel>
</Window>
